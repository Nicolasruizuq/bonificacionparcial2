<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" spacing="20" style="-fx-padding: 30; -fx-background-color: #f9f9f9;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.bonificacionparcial2.viewController.ProductoViewController">
    <children>
        <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Catálogo de Productos">
            <font>
                <Font name="Segoe UI" size="20.0" />
            </font>
        </Label>

        <Label style="-fx-font-size: 14; -fx-text-fill: #7f8c8d;" text="Lista completa de productos disponibles" />

        <HBox alignment="CENTER" spacing="10">
            <TextField promptText="Buscar producto..." style="-fx-pref-width: 300;"/>
            <Button style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Buscar" />
        </HBox>

        <TableView fx:id="tablaProductos" style="-fx-pref-height: 350;">
            <columns>
                <TableColumn text="Nombre" fx:id="colNombre" prefWidth="200"/>
                <TableColumn text="Precio" fx:id="colPrecio" prefWidth="100"/>
                <TableColumn text="Componentes" fx:id="colComponentes" prefWidth="250"/>
            </columns>
        </TableView>

        <HBox alignment="CENTER" spacing="20">
            <Button onAction="#volver" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 14;" text="Volver">
                <font>
                    <Font name="Segoe UI" size="12.0" />
                </font>
            </Button>
            <Label style="-fx-font-size: 12; -fx-text-fill: #95a5a6;" text="Mostrando productos" />
        </HBox>
    </children>
</VBox>