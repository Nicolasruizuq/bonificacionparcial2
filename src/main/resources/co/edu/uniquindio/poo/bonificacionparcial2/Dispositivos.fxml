<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="25" style="-fx-padding: 40; -fx-background-color: #f8f9fa;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.poo.bonificacionparcial2.viewController.DispositivoViewController">

    <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #212529; -fx-padding: 0 0 15 0;"
           text="Lista de Dispositivos" />

    <ListView fx:id="listaDispositivos" style="
        -fx-pref-height: 350;
        -fx-pref-width: 700;
        -fx-background-color: white;
        -fx-background-radius: 8;
        -fx-border-radius: 8;
        -fx-border-color: #dee2e6;
        -fx-border-width: 1;
        -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 10, 0, 0, 2);
        -fx-padding: 10;
        -fx-font-size: 14px;" />

    <Button onAction="#volver" style="
        -fx-min-width: 250;
        -fx-pref-height: 40;
        -fx-font-size: 16px;
        -fx-background-color: #6c757d;
        -fx-text-fill: white;
        -fx-background-radius: 6;
        -fx-padding: 0 30;
        -fx-font-weight: bold;
        -fx-cursor: hand;"
            text="Volver" />
</VBox>